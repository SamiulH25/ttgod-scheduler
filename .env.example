# Prisma: SQLite for local dev (file:./dev.db). For production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
DATABASE_URL="file:./dev.db"
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
BOT_API_SECRET=
NEXT_PUBLIC_APP_NAME="TTGOD Scheduler"
AUTH_URL=http://localhost:3000
# Local demo sign-in only when NODE_ENV=development (not used in production)
# Event image uploads stored under data/uploads/ (max 5MB per file)
UPLOAD_MAX_BYTES=5242880
