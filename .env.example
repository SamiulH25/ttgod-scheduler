# PostgreSQL (required). Local dev with Docker:
#   docker compose -f docker-compose.dev.yml up -d postgres
DATABASE_URL="postgresql://ttgod:ttgod_dev_password@localhost:5432/ttgod?schema=public"

NODE_ENV=development

AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000

BOT_API_SECRET=
NEXT_PUBLIC_APP_NAME="TTGOD Scheduler"

# Local demo sign-in only when NODE_ENV=development (disabled in production)
# UPLOAD_STORAGE=local | s3 (default: local)
UPLOAD_STORAGE=local
UPLOAD_MAX_BYTES=5242880

# Optional object storage (UPLOAD_STORAGE=s3)
# S3_ENDPOINT=https://...
# S3_BUCKET=ttgod-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_PREFIX=https://cdn.example.com
# S3_REGION=auto

# Optional error monitoring
# SENTRY_DSN=

# Open-Meteo weather (no API key)
# WEATHER_CACHE_TTL_SECONDS=3600

# Set on Docker app service only (validates secrets at container start)
# RUNTIME_ENV_VALIDATION=true
